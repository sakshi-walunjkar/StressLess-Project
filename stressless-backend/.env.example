# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/stressless
# For MongoDB Atlas (cloud), use format:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stressless?retryWrites=true&w=majority

# JWT Secret Key (Change this to a random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_123456789

# JWT Expiration
JWT_EXPIRE=7d

# CORS Origins (Add your Flutter app URLs)
CORS_ORIGIN=*
